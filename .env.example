
# Gemini API
GEMINI_API_KEY=your_gemini_api_key

# Tavily Search API
TAVILY_API_KEY=your_tavily_api_key

# Application
APP_NAME=Research Agent with Cited Reports
APP_ENV=development

# Database
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/research_agent

# Redis
REDIS_URL=redis://localhost:6379/0

# Research limits
MAX_RESEARCH_STEPS=8
MAX_RESEARCH_TIME_SECONDS=300
MAX_REPORT_COST_USD=1.00
